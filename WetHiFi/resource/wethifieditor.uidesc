<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
	<fonts>
		<font name="TinyFont" font-name="Arial" size="0"/>
	</fonts>

	<colors>
		<color name="Transparent" rgba="#00000000"/>
	</colors>

	<control-tags>
		<control-tag name="kHighsParam" tag="0"/>
		<control-tag name="kMidsParam" tag="1"/>
		<control-tag name="kBassParam" tag="2"/>
		<control-tag name="kOutPeak" tag="4"/>
	</control-tags>

	<!-- Generated by tools/make-assets-wethifi.py in the private toolkit.
	     Do not hand-edit: re-run the script, so the geometry here stays tied to
	     the rendered panel. -->
	<template background-color="~ BlackCColor"
	          bitmap="backplate"
	          class="CViewContainer"
	          name="view"
	          size="878, 468"
	          transparent="false">

		<view class="HiFiKnob"
		      control-tag="kHighsParam"
		      origin="85, 69"
		      size="108, 108"
		      bitmap="knob_highs"
		      step-count="41"
		      coarse-step="4"
		      transparent="false"/>
		<view class="HiFiKnob"
		      control-tag="kMidsParam"
		      origin="85, 180"
		      size="108, 108"
		      bitmap="knob_mids"
		      step-count="41"
		      coarse-step="4"
		      transparent="false"/>
		<view class="HiFiKnob"
		      control-tag="kBassParam"
		      origin="85, 291"
		      size="108, 108"
		      bitmap="knob_bass"
		      step-count="41"
		      coarse-step="4"
		      transparent="false"/>
		<view class="LampView"
		      origin="471, 62"
		      size="345, 345"
		      glass-centre="173, 172"
		      glass-radius="107.8"
		      transparent="true"/>
		<view class="PeakLed"
		      control-tag="kOutPeak"
		      origin="787, 46"
		      size="45, 45"
		      bitmap="peak_led"
		      transparent="false"/>
	</template>
	<custom>
		<attributes name="FocusDrawing"/>
		<attributes Path="wethifieditor.uidesc" name="VST3Editor"/>
	</custom>
	<bitmaps>
		<bitmap name="backplate" path="backplate.png"/>
		<bitmap name="knob_highs" path="knob_highs.png"
		        multiframe-size="108, 108"
		        multiframe-num-frames="41"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_mids" path="knob_mids.png"
		        multiframe-size="108, 108"
		        multiframe-num-frames="41"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_bass" path="knob_bass.png"
		        multiframe-size="108, 108"
		        multiframe-num-frames="41"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="peak_led" path="peak_led.png"
		        multiframe-size="45, 45"
		        multiframe-num-frames="4"
		        mulitframe-frames-per-row="1"/>
	</bitmaps>
</vstgui-ui-description>
